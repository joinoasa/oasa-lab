# Copy to /etc/oasa-lab/env (05-service.sh does this for you). Root-owned, mode 0640, never committed.
# The only secret the service needs: the GitHub OAuth App's client secret.
# GitHub: Settings > Developer settings > OAuth Apps > New. Callback URL: https://YOUR-HOSTNAME/oauth/github/callback
OASA_LAB_GITHUB_CLIENT_SECRET=replace-me
