# OASA lab job service config. 05-service.sh copies this to /etc/oasa-lab/service.toml.
# Nothing secret in here: the GitHub client secret lives in /etc/oasa-lab/env, API tokens are stored as hashes.

[service]
host = "127.0.0.1"                     # loopback only; the service refuses anything else
port = 8742
# The connector's public address (Cloudflare Tunnel hostname). Claude and the sign-in use it.
public_url = "https://lab-mcp.example.com"          # OWNER: your hostname
# Optional: a second hostname for the REST API and downloads, behind Cloudflare Access.
api_public_url = "https://lab-api.example.com"      # OWNER: your hostname, or delete this line
state_dir = "/var/lib/oasa-lab"
# The hardware suites' device file (see lab.example.toml). Jobs get it as OASA_LAB_INVENTORY.
# Outside /etc/oasa-lab on purpose: jobs cannot see that folder, and this file has no secrets.
devices_file = "/etc/oasa-lab.d/lab.toml"
repo = "https://github.com/joinoasa/oasa-lab"
branch = "main"
job_timeout_seconds = 1800
stop_grace_seconds = 10
max_queued = 20
# The oldest commit a caller may ask for with "commit": (a full 40-character id). Leave empty to allow any commit on main.
# Set it when a suite or the checker is fixed and the older versions must not run any more.
min_commit = ""
# Finished jobs whose evidence is kept on disk; the oldest beyond this are deleted.
keep_jobs = 100
min_free_mb = 2000                     # a job does not start with less free disk than this
max_bundle_mb = 500                    # the largest evidence bundle accepted from a job
# Your own pause switch, from a shell: `sudo touch /etc/oasa-lab/PAUSE`. While the file exists no job starts, and no
# API or Claude call can remove it. (The folder is root's; the service can look but not change.)
local_pause_file = "/etc/oasa-lab/PAUSE"

[sandbox]
# How jobs run: as the unprivileged user "oasalab-job", in their own systemd unit and cgroup, started by a small
# root helper (oasa-lab-jobrun.socket). Do not set mode = "none" on the lab PC.
mode = "systemd"
user = "oasalab-job"
socket = "/run/oasa-lab/jobrun.sock"
memory_max = "4G"
tasks_max = 512

[lab]
# How the radios are connected. The service refuses suites that transmit unless this is
# "cabled" or "shielded". Leave "unset" until you have verified the bench (cables, attenuators, box).
rf_setup = "unset"                     # unset | cabled | shielded | open

# Transmitting on real hardware also needs your say-so, one line per suite, naming the wiring you have
# connected (the wiring named in the suite's suite.toml; see docs/hardware-suites.md). The service then
# passes --confirm-wiring for you. Leave empty until the cables and attenuators are in place.
[confirm_wiring]
# l2-pluto-acceptance = "pluto"
# l2-rf-control = "lora"

[inventory]
backend = "usb"                        # "usb" on the lab PC; "simulated" for trying it out anywhere

# Fill in the USB ids from `lsusb` on your PC. These are the usual ones.
[[inventory.devices]]
id = "pluto"
kind = "pluto"
tcp = "192.168.2.1:30431"              # iiod on the lab network; the service only checks it answers

[[inventory.devices]]
id = "rtlsdr"
kind = "rtlsdr"
usb = "0bda:2838"                      # RTL-SDR Blog V4 (RTL2838)

[[inventory.devices]]
id = "heltec-a"
kind = "serial-radio"
usb = "10c4:ea60"                      # CP210x on the Heltec V3. Check with lsusb.

[[inventory.devices]]
id = "heltec-b"
kind = "serial-radio"
usb = "10c4:ea60"

[[inventory.devices]]
id = "usbhub"
kind = "hub"
usb = "0000:0000"                      # OWNER: the switchable hub's id from lsusb

[profiles.bench-cabled]
requires = ["pluto", "rtlsdr", "heltec-a", "heltec-b"]
description = "Everything on the bench, joined by cable and attenuators"

# Claude Code (the command line tool) signs in through a loopback address. Allow it only if you use it:
# [oauth]
# redirect_uris = ["https://claude.ai/api/mcp/auth_callback", "https://claude.com/api/mcp/auth_callback", "http://localhost/callback"]

[github]
client_id = "replace-with-your-github-oauth-app-client-id"   # OWNER: not secret

# Users. One admin to start. Adding someone is adding a block here and restarting the service.
# Roles: viewer (look), runner (look, run, stop own), admin (everything, pause).
[[users]]
name = "citruscybersec"
role = "admin"
github_login = "citruscybersec"
github_id = 232992090                  # numeric id; sign-in checks this, not the name. gh api users/citruscybersec --jq .id
email = "imjctaylor@gmail.com"         # for Cloudflare Access on the API hostname

# [[users]]
# name = "someone"
# role = "runner"
# github_id = 123456

# API tokens for scripts and other MCP clients. Make one with:  oasa-lab token owner-laptop --user citruscybersec
# Paste the printed block here. Only the hash is stored.
# [[tokens]]
# name = "owner-laptop"
# user = "citruscybersec"
# sha256 = "..."

# Cloudflare Access on the API hostname (not the connector): the service checks the JWT Access adds.
# [cloudflare_access]
# team_domain = "yourteam.cloudflareaccess.com"
# audience = "application AUD tag from the Access dashboard"
