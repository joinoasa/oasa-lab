# Copy to setup.env and edit. Not secret: these are choices, not keys. setup.env is git-ignored.

# The network card the Pluto+ cable goes into. Not the one that reaches your router.
# Find it with:  ip -br link
LAB_IFACE=enp3s0

# Addresses on the lab network (a cable between the PC and the Pluto+, nothing else on it).
# Check your Pluto+'s address in its config.txt (ADALM-Pluto default is 192.168.2.1).
LAB_HOST_IP=192.168.2.10/24
PLUTO_IP=192.168.2.1

# WireGuard (for you, to log in and maintain the PC).
WG_PORT=51820
WG_SERVER_IP=10.77.0.1/24
OWNER_WG_IP=10.77.0.2/32
# Your laptop's WireGuard PUBLIC key (a public key is not a secret). Leave empty until you have it.
OWNER_WG_PUBKEY=

# Allow SSH from your home network too? Empty means SSH only over WireGuard.
# Example: 192.168.1.0/24. Set it BEFORE running 03-firewall.sh if you are logged in over the LAN now.
SSH_FROM_LAN_CIDR=

# Where the service code comes from, and WHICH VERSION. Required: a full commit id (40 characters) or a release tag.
# Not a branch name: a branch moves, and the lab runs this code as root-adjacent software. Run these scripts from a
# checkout of the same commit, because the hashed dependency lists (requirements.lock) come from that checkout.
#   git ls-remote https://github.com/joinoasa/oasa-lab refs/heads/main     # the commit you reviewed
LAB_REPO_URL=https://github.com/joinoasa/oasa-lab
LAB_REF=

# Cloudflare Tunnel hostnames (names in a domain you own on Cloudflare).
# MCP_HOSTNAME is the Claude connector. API_HOSTNAME is the REST API behind Cloudflare Access (optional).
MCP_HOSTNAME=lab-mcp.example.com
API_HOSTNAME=lab-api.example.com
