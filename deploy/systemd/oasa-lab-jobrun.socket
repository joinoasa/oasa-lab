[Unit]
Description=OASA lab: socket for the job helper (only the service user may connect)
Documentation=https://github.com/joinoasa/oasa-lab/blob/main/docs/remote-lab.md

[Socket]
ListenStream=/run/oasa-lab/jobrun.sock
SocketUser=oasalab
SocketGroup=oasalab
SocketMode=0600
DirectoryMode=0755
Accept=yes
MaxConnections=8
MaxConnectionsPerSource=8

[Install]
WantedBy=sockets.target
