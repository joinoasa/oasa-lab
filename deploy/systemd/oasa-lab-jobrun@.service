[Unit]
Description=OASA lab job helper (one per connection; starts a job as the job user)
Documentation=https://github.com/joinoasa/oasa-lab/blob/main/docs/remote-lab.md

[Service]
# Runs as root, because only root may start a unit as another user. It does as little as it can: three verbs
# (run, stop, clean) and a job id; everything else comes from /etc/oasa-lab/service.toml, which only root can edit.
# The connection is standard input and output.
ExecStart=/opt/oasa-lab/venv/bin/python -I -m oasa_lab.service.jobrun serve
StandardInput=socket
StandardOutput=socket
StandardError=journal
# It starts systemd-run and writes one small file into the job folder; it needs no network and no devices.
NoNewPrivileges=yes
PrivateNetwork=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
TimeoutStopSec=15
